{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@hermes/plugin-sdk": ["./src/sdk/index.ts"],
      "@hermes/shared": ["./src/shared/index.ts"]
    }
  },
  "include": ["src"],
  // 上游 bots 的测试辅助（只被 .test 文件引用，生产不用）——与上游
  // 自己的 tsconfig 一致：测试支撑不进主编译。
  "exclude": ["src/hermes-mirror/plugins/hermes-bots/__test_utils__"]
}
