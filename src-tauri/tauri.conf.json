{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirach Harness",
  "mainBinaryName": "mirach-harness",
  "version": "0.1.0",
  "identifier": "com.mirach.harness",
"build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mirach Harness",
        "width": 1800,
        "height": 1000,
        "minWidth": 600,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "additionalBrowserArgs": "--remote-debugging-port=9223"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
