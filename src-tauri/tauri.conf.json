{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirach Harness",
  "mainBinaryName": "mirach-harness",
  "version": "0.1.0",
  "identifier": "com.mirach.harness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mirach Harness",
        "width": 1800,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "additionalBrowserArgs": "--remote-debugging-port=9223"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
